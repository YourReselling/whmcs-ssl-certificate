      "name": "download",
      "method": "GET",
      "path": "/products/ssl-certificates/{certificate}/download",
      "summary": "Download certificate",
      "description": "Returns the issued certificate. `format` selects what you get: the certificate itself (`crt`), the intermediate chain (`ca-bundle`), the root (`ca`), a PKCS#7 container (`pkcs7`), the CSR (`csr`) or a ZIP with everything (`zip`). Binary formats come back base64-encoded, indicated by `encoding`.",
      "germanSummary": "Zertifikat herunterladen",
      "permissions": [
        "certificates:read"
      ],
      "authenticated": true,
      "pathParameters": [
        {
          "name": "certificate",
          "type": "string",
          "description": "Certificate ID"
        }
      ],
      "query": {
        "type": "object",
        "properties": {
          "format": {
            "description": "Download format",
            "type": "string",
            "enum": [
              "crt",
              "ca-bundle",
              "ca",
              "pkcs7",
              "csr",
              "zip"
            ],
            "default": "crt",
            "x-validation": [
              "sometimes"
            ],
            "x-validation-expressions": [
              "Rule::in(array_keys($formats))"
            ]
          }
        },
        "additionalProperties": true,
        "required": []
      },
      "body": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "bodyRequired": false,
      "requestContentType": "application/json",
      "responseMode": "json",
      "responses": [
        {
          "status": 200,
          "description": "Certificate content",
          "germanDescription": "Zertifikatsinhalt",
          "schema": null,
          "example": {
            "success": true,
            "data": {
              "common_name": "example.com",
              "format": "crt",
              "filename": "example.com.crt",
              "encoding": "utf-8",
              "content": "-----BEGIN CERTIFICATE-----\n…"
            }
          },
          "contentType": "application/json"
        },
